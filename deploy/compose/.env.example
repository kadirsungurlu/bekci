# Panelin adresi (DNS A kaydı bu sunucuyu göstermeli).
UPTIME_DOMAIN=bekci.ornek.com

# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=admin@ornek.com

# Veritabanı şifresi. Bağlantı adresine yazıldığı için yalnız harf ve rakam
# kullanın; üretmek için: openssl rand -hex 24
POSTGRES_PASSWORD=

# latest son kararlı sürümdür. Sabitlemek / geri dönmek için sürüm numarası
# yazın (ör. 1.7.0). Güncellemeden önce yedek alın (bkz. docker-compose.yml
# başındaki açıklama).
UPTIME_TAG=latest

TZ=Europe/Istanbul
LOG_LEVEL=info

# Aynı anda en fazla kontrol sayısı (yüzlerce monitörde artırılabilir).
MAX_CONCURRENT_CHECKS=50

# Durum sayfası özel alan adları artık otomatik (Caddyfile'daki on-demand TLS
# bloğu): panelde sayfaya alan adı yazmak yeterli. STATUS_DOMAIN yalnız eski,
# elle eklenmiş site bloğu kullanan kurulumlar için tutulur.
# STATUS_DOMAIN=durum.ornek.com

# Gerçek ziyaretçi IP'si için güvenilen vekil (Caddy'nin compose ağı). Ağı
# öğrenmek için: docker network inspect bekci_default -f '{{(index .IPAM.Config 0).Subnet}}'
# TRUSTED_PROXY=172.18.0.0/16
