# Panelin adresi (DNS A kaydı bu sunucuyu göstermeli).
UPTIME_DOMAIN=uptime.ornek.com

# Let's Encrypt sertifika bildirimleri için e-posta.
ACME_EMAIL=admin@ornek.com

# latest: SQLite (önerilen) | postgres: PostgreSQL gömülü sürüm
# Sürümü sabitlemek / geri dönmek için commit etiketi: abc1234 (SQLite) ya da
# postgres-abc1234 (PostgreSQL). Güncellemeden önce yedek alın (bkz.
# docker-compose.yml başındaki açıklama).
UPTIME_TAG=latest

TZ=Europe/Istanbul
LOG_LEVEL=info

# Aynı anda en fazla kontrol sayısı (yüzlerce monitörde artırılabilir).
MAX_CONCURRENT_CHECKS=50

# İsteğe bağlı: durum sayfası için ayrı alan adı (Caddyfile'daki bloğu da açın).
# STATUS_DOMAIN=durum.ornek.com
