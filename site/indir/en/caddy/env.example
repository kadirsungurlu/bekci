# Bekci + Caddy settings. On the server this file must be named ".env" and sit
# in the same folder as docker-compose.yml (e.g. /opt/bekci/.env).
# Guide: https://bekci.app/en/docs/install/caddy/

# The panel's domain (without http:// and /). Its DNS A record must point here.
UPTIME_DOMAIN=bekci.example.com

# Your email address for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# Database password. Letters and digits only; to generate one:
# openssl rand -hex 24
POSTGRES_PASSWORD=

# latest or a fixed version (e.g. 1.0.0).
UPTIME_TAG=latest

# Time zone for daily summaries and the nightly backup.
TZ=Europe/Istanbul
LOG_LEVEL=info

# Maximum number of checks at the same time (raise it for hundreds of monitors).
MAX_CONCURRENT_CHECKS=50

# Status page custom domains are now automatic (the on-demand TLS block in the
# Caddyfile): entering the domain on the page in the panel is enough. STATUS_DOMAIN
# is only kept for older installs that use a hand-written site block.
# STATUS_DOMAIN=status.example.com

# Trusted proxy for the real visitor IP (the compose network Caddy runs on). To
# find it: docker network inspect bekci_default -f '{{(index .IPAM.Config 0).Subnet}}'
# TRUSTED_PROXY=172.18.0.0/16
